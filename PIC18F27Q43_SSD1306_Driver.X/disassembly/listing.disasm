179:           static inline void SSD1306SetAdd(){
180:               //この関数はマクロからのみ叩く
181:               uint8_t dmaSave = DMASELECT;
182:               DMASELECT = DMA_I2C_TX;
183:               DMAnCON0bits.EN = 0;
184:               DMA_SET_SOURCE_GPR();
185:               DMAnSSZ = (uint16_t)6;
186:               DMAnSSA = (uint16_t)&SSD1306SetAddressBuff;
187:               DMAnCON0bits.EN = 1;
188:               I2C1CNT = 6 + 1;
189:               I2C1TXB = SSD1306_CTRL_CMD_STREAM;
190:               I2C1CON0bits.S = 1;
191:               DMAnCON0bits.SIRQEN = 1;
192:               DMASELECT = dmaSave;
193:           }
194:           
195:           //書き込みアドレス指定関数(この関数は開始場所を指定して，終わりは最後になる．モードは変更しない)
196:           #define SSD1306SetAddS(column, page)\
197:           do {\
198:               SSD1306SetAddressBuff.columnStart = (uint8_t)column;\
199:               SSD1306SetAddressBuff.columnEnd = 127;\
200:               SSD1306SetAddressBuff.pageStart = (uint8_t)page;\
201:               SSD1306SetAddressBuff.pageEnd = 7;\
202:               SSD1306SetAdd();\
203:           }while (0)
204:           
205:           //書き込みアドレス指定関数(この関数は開始場所と，終了場所を指定する．モードは変更しない)
206:           #define SSD1306SetAddSE(columnStart, pageStart, columnEnd, pageEnd)\
207:           do {\
208:               SSD1306SetAddressBuff.columnStart = (uint8_t)columnStart;\
209:               SSD1306SetAddressBuff.columnEnd = (uint8_t)columnEnd;\
210:               SSD1306SetAddressBuff.pageStart = (uint8_t)pageStart;\
211:               SSD1306SetAddressBuff.pageEnd = (uint8_t)pageEnd;\
212:               SSD1306SetAdd();\
213:           }while (0)
