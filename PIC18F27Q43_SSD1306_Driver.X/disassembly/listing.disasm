215:           //ページ転送用関数(DMA使用)
216:           static inline void SSD1306DrawPage(volatile uint16_t buffAdder){
217:               uint8_t dmaSave = DMASELECT;
218:               DMASELECT = DMA_I2C_TX;
219:               DMAnCON0bits.EN = 0;
220:               DMA_SET_SOURCE_GPR();
221:               DMAnSSZ = (uint16_t)128;
222:               DMAnSSA = buffAdder;
223:               DMAnCON0bits.EN = 1;
224:               I2C1CNT = 128 + 1;
225:               I2C1TXB = SSD1306_CTRL_DATA_STREAM;
226:               I2C1CON0bits.S = 1;
227:               DMAnCON0bits.SIRQEN = 1;
228:               DMASELECT = dmaSave;
229:           }
