403:           static inline void SSD1306DrawPageStartFromPFM(uint24_t buffAdder){
404:               uint8_t dmaSave = DMASELECT;
405:               DMASELECT = DMA_I2C_TX;
406:               DMAnCON0bits.EN = 0;
407:               DMA_SET_SOURCE_PFM();
408:               DMAnSSZ = 128;
409:               DMAnSSA = buffAdder;
410:               DMAnCON0bits.EN = 1;
411:               I2C1CNT = (volatile uint8_t)(128 + 1 + I2C_SURPLUS_COUNT);//転送完了後もストップコンディション出ない様に1つ多めにしておく
412:               I2C1TXB = SSD1306_CTRL_DATA_STREAM;
413:               I2C1CON0bits.S = 1;
414:               DMAnCON0bits.SIRQEN = 1;
415:               DMASELECT = dmaSave;
416:           }
417:           static inline void SSD1306DrawPageContinueFromPFM(uint24_t buffAdder){
418:               uint8_t dmaSave = DMASELECT;
419:               DMASELECT = DMA_I2C_TX;
420:               DMAnCON0bits.EN = 0;
421:               DMAnSSA = buffAdder;
422:               DMAnCON0bits.EN = 1;
423:               I2C1CNT += (volatile uint8_t)128;//多分アトミックな操作
424:               DMAnCON0bits.SIRQEN = 1;
425:               DMASELECT = dmaSave;
426:           }
427:           static inline void SSD1306DrawPageEndFromPFM(uint24_t buffAdder){
428:               uint8_t dmaSave = DMASELECT;
429:               DMASELECT = DMA_I2C_TX;
430:               DMAnCON0bits.EN = 0;
431:               DMAnSSA = buffAdder;
432:               DMAnCON0bits.EN = 1;
433:               I2C1CNT += (volatile uint8_t)(128 - I2C_SURPLUS_COUNT);//元々1バイト多かったので，一バイト少なくしておく．多分アトミックな操作
434:               DMAnCON0bits.SIRQEN = 1;
435:               DMASELECT = dmaSave;
436:           }
437:           
438:           typedef struct{
439:               uint8_t offsetCom;
440:               uint8_t offset;
441:           } SSD1306VerticalOffset_t;
442:           SSD1306VerticalOffset_t SSD1306SetVerticalOffsetBuff = {
443:               .offsetCom = 0xD3
444:           };
445:           
446:           //この関数は，SSD1306本体の描画範囲を選択します．これをいじると，縦方向にスクロールできます
447:           static inline void SSD1306SetVerticalOffset(uint8_t offset){
448:               SSD1306SetVerticalOffsetBuff.offset = (offset & 0x3F);
449:               uint8_t dmaSave = DMASELECT;
450:               DMASELECT = DMA_I2C_TX;
451:               DMAnCON0bits.EN = 0;
452:               DMA_SET_SOURCE_GPR();
453:               DMAnSSZ = (uint16_t)2;
454:               DMAnSSA = (uint16_t)&SSD1306SetVerticalOffsetBuff;
455:               DMAnCON0bits.EN = 1;
456:               I2C1CNT = 2 + 1;
457:               I2C1TXB = SSD1306_CTRL_CMD_STREAM;
458:               I2C1CON0bits.S = 1;
459:               DMAnCON0bits.SIRQEN = 1;
460:               DMASELECT = dmaSave;
461:           }
462:           
463:           typedef struct{
464:               uint8_t offsetComL;
465:               uint8_t offsetComH;
466:           } SSD1306HorizontalOffset_t;
467:           SSD1306HorizontalOffset_t SSD1306SetHorizontalOffsetBuff;
468:           
469:           static inline void SSD1306SetHorizontalOffset(uint8_t offset){
470:               SSD1306SetHorizontalOffsetBuff.offsetComL = (offset & 0x0F);
471:               SSD1306SetHorizontalOffsetBuff.offsetComH = (((offset >> 4) & 0x07) | 0x10);
472:               uint8_t dmaSave = DMASELECT;
473:               DMASELECT = DMA_I2C_TX;
474:               DMAnCON0bits.EN = 0;
475:               DMA_SET_SOURCE_GPR();
476:               DMAnSSZ = (uint16_t)2;
477:               DMAnSSA = (uint16_t)&SSD1306SetHorizontalOffsetBuff;
478:               DMAnCON0bits.EN = 1;
479:               I2C1CNT = 2 + 1;
480:               I2C1TXB = SSD1306_CTRL_CMD_STREAM;
481:               I2C1CON0bits.S = 1;
482:               DMAnCON0bits.SIRQEN = 1;
483:               DMASELECT = dmaSave;
484:           }
